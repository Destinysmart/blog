rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All reads and writes flow through the BitLance API server, which
    // authenticates with the Firebase Admin SDK (service account) and
    // bypasses these rules. Direct client access is fully denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
